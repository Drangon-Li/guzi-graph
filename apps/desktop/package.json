{
  "name": "excalidraw-local-desktop",
  "version": "0.8.3",
  "private": true,
  "description": "A local desktop workspace for Excalidraw drawings",
  "author": "Local",
  "license": "MIT",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "npm run test:main && npm run test:renderer && npm run test:packaging",
    "package": "npm run prepare:updater && npm run build && electron-builder --mac dmg --arm64 --publish never",
    "package:dev-ppt": "npm run build:dev-ppt && electron-builder --config electron-builder.dev-ppt.cjs --mac dmg --arm64 --publish never",
    "package:test": "npm run build:test && electron-builder --config electron-builder.testing.cjs --mac dmg --arm64 --publish never",
    "package:dir": "npm run prepare:updater && npm run build && electron-builder --mac dir --arm64 --publish never",
    "test:renderer": "cd ../.. && vitest --config tooling/config/test/vitest.config.mts run apps/desktop/src/renderer --reporter=dot",
    "test:mcp:e2e": "node scripts/mcp-e2e.cjs",
    "test:mcp:plugins": "node scripts/mcp-plugins-e2e.cjs",
    "test:mcp:clients": "node scripts/mcp-e2e.cjs --clients",
    "build:dev-ppt": "node scripts/build-channel.cjs dev-ppt",
    "build:test": "node scripts/build-channel.cjs test",
    "test:main": "node scripts/test-main.cjs",
    "test:packaging": "node --test scripts/packaging.test.cjs scripts/release-assets.test.cjs scripts/prepare-updater.test.cjs scripts/update-windows-e2e.test.cjs",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:win:dir": "npm run build && electron-builder --win --x64 --dir --publish never",
    "package:win:test": "npm run build:test && electron-builder --config electron-builder.testing.cjs --win nsis --x64 --publish never",
    "package:win:test:dir": "npm run build:test && electron-builder --config electron-builder.testing.cjs --win --x64 --dir --publish never",
    "package:win:dev-ppt": "npm run build:dev-ppt && electron-builder --config electron-builder.dev-ppt.cjs --win nsis --x64 --publish never",
    "test:smoke": "node scripts/desktop-smoke.cjs",
    "prepare:updater": "node scripts/prepare-updater.cjs",
    "package:update": "node scripts/release-assets.cjs mac-archive"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.7",
    "electron-updater": "6.8.11"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.excalidraw.desktop",
    "productName": "Excalidraw-Guzi",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "!src/**/*.test.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.excalidraw.txt"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "resources/icon.icns",
      "artifactName": "Excalidraw-Guzi-${version}-${arch}.${ext}",
      "minimumSystemVersion": "13.0",
      "extendInfo": {
        "SUPublicEDKey": "TtcL0UT0i9++qIe4Ns+h18iCdOuCZpYhApiuXitvJRg="
      },
      "extraResources": [
        {
          "from": "vendor/updater/Guzi Updater.app",
          "to": "updater/Guzi Updater.app"
        },
        {
          "from": "native/updater/LICENSE.Sparkle",
          "to": "updater/LICENSE.sparkle"
        }
      ],
      "signIgnore": [
        "/Contents/Resources/updater/"
      ]
    },
    "dmg": {
      "sign": false
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw 画布",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      },
      {
        "ext": "guzi-presentation",
        "name": "Guzi 演示文稿",
        "role": "Editor",
        "mimeType": "application/vnd.guzi.presentation+json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "artifactName": "Excalidraw-Guzi-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Drangon-Li",
        "repo": "guzi-graph",
        "releaseType": "release"
      }
    ]
  },
  "productName": "Excalidraw-Guzi"
}
