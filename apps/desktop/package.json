{
  "name": "excalidraw-local-desktop",
  "version": "0.7.1",
  "private": true,
  "description": "A local macOS workspace for Excalidraw drawings",
  "author": "Local",
  "license": "MIT",
  "main": "src/main/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "node --test src/main/*.test.cjs src/main/i18n/*.test.cjs && npm run test:renderer",
    "package": "npm run build && electron-builder --mac dmg --arm64",
    "package:dev-ppt": "VITE_DESKTOP_BUILD_CHANNEL=dev-ppt npm run build && electron-builder --config electron-builder.dev-ppt.cjs --mac dmg --arm64",
    "package:test": "VITE_DESKTOP_BUILD_CHANNEL=test npm run build && electron-builder --config electron-builder.testing.cjs --mac dmg --arm64",
    "package:dir": "npm run build && electron-builder --mac dir --arm64",
    "test:renderer": "cd ../.. && vitest --config tooling/config/test/vitest.config.mts run apps/desktop/src/renderer --reporter=dot",
    "test:mcp:e2e": "node scripts/mcp-e2e.cjs",
    "test:mcp:plugins": "node scripts/mcp-plugins-e2e.cjs",
    "test:mcp:clients": "node scripts/mcp-e2e.cjs --clients"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "electron": "44.7.2",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "local.excalidraw.desktop",
    "productName": "Excalidraw-Guzi",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "!src/**/*.test.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../LICENSE",
        "to": "LICENSE.excalidraw.txt"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "icon": "resources/icon.icns",
      "artifactName": "Excalidraw-Guzi-${version}-${arch}.${ext}"
    },
    "dmg": {
      "sign": false
    },
    "fileAssociations": [
      {
        "ext": "excalidraw",
        "name": "Excalidraw 画布",
        "role": "Editor",
        "mimeType": "application/vnd.excalidraw+json"
      },
      {
        "ext": "guzi-presentation",
        "name": "Guzi 演示文稿",
        "role": "Editor",
        "mimeType": "application/vnd.guzi.presentation+json"
      }
    ]
  },
  "productName": "Excalidraw-Guzi"
}
